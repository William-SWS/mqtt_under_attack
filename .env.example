###############################################
# Exemplo de configuração de ambiente
#
# Copie este arquivo para `.env` e ajuste
# os valores conforme o ambiente/máquina.
###############################################

# Caminho base para a pasta de dados.
# - Pode ser ABSOLUTO (recomendado se os dados ficam fora do repositório)
# - Ou RELATIVO à raiz do projeto (por exemplo: "data")
# Se esta variável não for definida, o código usa `PROJ_ROOT / "data"`.
#
# Exemplos:
# DATA_DIR=data
# DATA_DIR=/caminho/completo/para/sua/pasta/data

DATA_DIR=/caminho/para/sua/pasta/data

# Caminho para a pasta de modelos.
# Se não for definida, o código usa `PROJ_ROOT / "models"`.
#
# Exemplos:
# MODELS_DIR=models
# MODELS_DIR=/caminho/completo/para/sua/pasta/models

MODELS_DIR=/caminho/para/sua/pasta/models

# Caminho para a pasta de relatórios.
# Se não for definida, o código usa `PROJ_ROOT / "reports"`.
#
# Exemplos:
# REPORTS_DIR=reports
# REPORTS_DIR=/caminho/completo/para/sua/pasta/reports

REPORTS_DIR=/caminho/para/sua/pasta/reports

# Caminho para a pasta de figuras (dentro de reports).
# Se não for definida, o código usa `REPORTS_DIR / "figures"`.
#
# Exemplos:
# FIGURES_DIR=reports/figures
# FIGURES_DIR=/caminho/completo/para/sua/pasta/figures

FIGURES_DIR=/caminho/para/sua/pasta/figures

